# Vin Desk - production settings for docker-compose.prod.yml
# Copy to .env.production on the server and fill in every value. Never commit the real file.

# Your web address (DNS A record pointing at the server). Caddy gets the HTTPS certificate for it.
DOMAIN=service.yourcentre.in
PUBLIC_BASE_URL=https://service.yourcentre.in
CORS_ORIGINS=https://service.yourcentre.in

# Database password (any long random string). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# At least 32 random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Email (Gmail: use a Google App Password, see docs/deployment.md)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDER_ADDRESS=

# SMS: off (invoices by email only). Set msg91 + MSG91_AUTH_KEY to turn it on.
SMS_PROVIDER=disabled

# WhatsApp: off. Set meta + the values below to send invoices and reminders on WhatsApp
# (docs/deployment.md, "WhatsApp setup").
WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

WORKER_POLL_SECONDS=5

# --- Parts sheet sync ---------------------------------------------------------
# Google Sheet with the parts catalogue (shared as "anyone with the link can view"). Empty = off.
# Staff edit the sheet; the app picks up new parts and name/cost/bin changes every 30 seconds.
# Stock quantities are not taken from the sheet after a part's opening stock.
PARTS_SHEET_URL=
PARTS_SHEET_SYNC_SECONDS=30
