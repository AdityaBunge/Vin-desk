# Vin Desk - configuration
# Copy to `.env` (repository root or backend/) and adjust. Never commit the real file.
# Every value below is read by backend/app/core/config.py.

# development | production   (tests set this to "test" themselves)
APP_ENV=development

# --- Database -----------------------------------------------------------------
# Default matches scripts/dev-db.ps1 (isolated local cluster, trust auth, port 5544).
# With docker-compose.yml use: postgresql+psycopg://fsc:fsc_dev_password@localhost:5432/fsc_dev
DATABASE_URL=postgresql+psycopg://fsc@localhost:5544/fsc_dev
# Used only by the test suite; the database name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg://fsc@localhost:5544/fsc_test

# --- Security -----------------------------------------------------------------
# REQUIRED in production: at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Secret that signs customer invoice links (defaults to JWT_SECRET). Changing it invalidates all links.
INVOICE_LINK_SECRET=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Base URL customers see in invoice links. Must be https:// in production.
PUBLIC_BASE_URL=http://localhost:5173

# --- Email --------------------------------------------------------------------
# dev  = SIMULATOR: writes .eml files to backend/var/dev_outbox, sends nothing (refused in production)
# smtp = any SMTP relay (Amazon SES, SendGrid, Mailgun, Zoho, Google Workspace, Gmail, ...)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls, SMTP_USERNAME and
#   EMAIL_SENDER_ADDRESS = the Gmail address, SMTP_PASSWORD = a Google App Password (needs 2-Step Verification).
# Check the settings with: python scripts/send_test_email.py you@example.com   (run in backend/)
EMAIL_PROVIDER=dev
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDER_ADDRESS=

# --- SMS ----------------------------------------------------------------------
# dev   = SIMULATOR: appends to backend/var/dev_outbox/sms.log, sends nothing (refused in production)
# msg91 = MSG91 Flow API (India). Also set the DLT template ID and sender ID in Admin > Settings.
# disabled = no SMS at all; invoices are sent by email only (allowed in production)
SMS_PROVIDER=dev
MSG91_AUTH_KEY=

# --- WhatsApp -----------------------------------------------------------------
# Invoices (PDF attached) plus payment-due and service-due reminders, through Meta's WhatsApp
# Cloud API. Setup and the three message templates: docs/deployment.md, "WhatsApp setup".
# disabled = no WhatsApp (default)
# dev      = SIMULATOR: appends to backend/var/dev_outbox/whatsapp.log, sends nothing (refused in production)
# meta     = WhatsApp Cloud API
WHATSAPP_PROVIDER=disabled
# Permanent System User token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# The sending number's "Phone number ID" from the app's WhatsApp > API Setup page (not the number).
WHATSAPP_PHONE_NUMBER_ID=
# App secret (App settings > Basic): verifies Meta's message-status webhooks.
WHATSAPP_APP_SECRET=
# Any random string; enter the same value when registering the webhook in the Meta app.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Shared secret for delivery-receipt webhooks (HMAC-SHA256 of the raw body). Empty = webhooks disabled.
WEBHOOK_SECRET=

# --- Background worker --------------------------------------------------------
# true: the API process also runs the invoice-delivery worker (simple, fine for one process).
# false: run `python -m app.workers.delivery_worker` as its own service (recommended in production).
RUN_WORKER_IN_API=true
WORKER_POLL_SECONDS=5

# --- Limits -------------------------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
PUBLIC_LINK_RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_BYTES=5242880

# --- Parts sheet sync ---------------------------------------------------------
# Google Sheet with the parts catalogue (shared as "anyone with the link can view"). Empty = off.
# Staff edit the sheet; the app picks up new parts and name/cost/bin changes every 30 seconds.
# Stock quantities are not taken from the sheet after a part's opening stock.
PARTS_SHEET_URL=
PARTS_SHEET_SYNC_SECONDS=30
